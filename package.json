{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "Clonagem do https://www,tabnews,com,br no https://curso.dev",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:down": "docker compose -f infra/compose.yaml down",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "jest",
    "test:whatch": "jest --watchAll"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "compose": "^0.1.2",
    "docker": "^0.2.14",
    "next": "^16.1.1",
    "next.js": "^1.0.3",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "jest": "^29.6.2",
    "prettier": "^3.7.4"
  }
}
